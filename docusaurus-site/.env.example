# =============================================================================
# Docusaurus Site - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the required values.
# Command: cp .env.example .env.local (Mac/Linux)
#          copy .env.example .env.local (Windows)
#
# IMPORTANT: Never commit .env.local to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Authentication (Clerk)
# -----------------------------------------------------------------------------
# Get your keys from: https://dashboard.clerk.com
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key-here

# -----------------------------------------------------------------------------
# Deployment (Optional - for deployment scripts)
# -----------------------------------------------------------------------------
# Your production site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Development Settings
# -----------------------------------------------------------------------------
# Node environment (development | production)
NODE_ENV=development

# Server port (default: 3000 for Docusaurus)
PORT=3000

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# - REACT_APP_CLERK_PUBLISHABLE_KEY: Required for authentication features
#   Get this from your Clerk dashboard (Publishable Key, NOT Secret Key)
#
# - NEXT_PUBLIC_SITE_URL: Used for Open Graph metadata and sitemaps
#   Development: http://localhost:3000
#   Production: https://your-site.vercel.app
#
# - All variables prefixed with REACT_APP_ are exposed to the browser
# - All variables prefixed with NEXT_PUBLIC_ are exposed to the browser
#
# -----------------------------------------------------------------------------
# Quick Start
# -----------------------------------------------------------------------------
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in your Clerk publishable key
# 3. Run: npm install
# 4. Start dev server: npm start
# 5. Visit: http://localhost:3000
#
# -----------------------------------------------------------------------------
# Getting Clerk Keys
# -----------------------------------------------------------------------------
# 1. Go to https://dashboard.clerk.com
# 2. Select your application (or create one)
# 3. Go to API Keys
# 4. Copy the "Publishable Key" (starts with pk_test_ or pk_live_)
# 5. Paste it above as REACT_APP_CLERK_PUBLISHABLE_KEY
#
# =============================================================================
