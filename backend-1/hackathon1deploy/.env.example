# =============================================================================
# AI-Native Book RAG Chatbot Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the required values.
# Command: cp .env.example .env (Mac/Linux)
#          copy .env.example .env (Windows)
#
# IMPORTANT: NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI API Configuration (Required)
# -----------------------------------------------------------------------------
# OpenAI API key for embeddings (text-embedding-ada-002) and chat (gpt-4o-mini)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# -----------------------------------------------------------------------------
# Qdrant Vector Database (Required)
# -----------------------------------------------------------------------------
# Qdrant Cloud cluster URL (e.g., https://your-cluster-id.aws.cloud.qdrant.io:6333)
# Get from: https://cloud.qdrant.io
QDRANT_URL=https://your-qdrant-cluster-url.qdrant.io:6333

# Qdrant Cloud API key for authentication
# Get from: https://cloud.qdrant.io/apikeys
QDRANT_API_KEY=your-qdrant-api-key-here

# Qdrant collection name (stores embedded vectors)
# Default: ai-native-book (can be changed per project)
QDRANT_COLLECTION=ai-native-book

# -----------------------------------------------------------------------------
# PostgreSQL Database (Required)
# -----------------------------------------------------------------------------
# Neon PostgreSQL connection string for session storage
# Format: postgresql://username:password@host:port/database
# Get from: https://console.neon.tech
DATABASE_URL=postgresql://username:password@hostname:5432/dbname

# -----------------------------------------------------------------------------
# API Security (Required)
# -----------------------------------------------------------------------------
# Secret key for /api/ingest endpoint authentication
# Generate a strong random key: openssl rand -hex 32
INGEST_API_KEY=your-super-secret-ingest-key-here-min-32-chars

# -----------------------------------------------------------------------------
# CORS Configuration (Optional)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
# Development: http://localhost:3000
# Production: https://your-site.vercel.app,https://your-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Environment & Deployment (Optional)
# -----------------------------------------------------------------------------
# Deployment environment (development | staging | production)
ENVIRONMENT=development

# GitHub Personal Access Token for private repository ingestion
# Get from: https://github.com/settings/tokens
# Only needed if ingesting from private GitHub repositories
GITHUB_TOKEN=ghp_your-github-personal-access-token

# -----------------------------------------------------------------------------
# RAG Pipeline Settings (Optional)
# -----------------------------------------------------------------------------
# Maximum tokens in LLM response (controls answer length)
# Recommended: 200-800 (default: 400)
MAX_ANSWER_TOKENS=400

# Number of days to retain request logs in database
# Set to 0 to disable log retention (default: 7)
LOG_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# Advanced Settings (Optional)
# -----------------------------------------------------------------------------
# Rate limiting: requests per minute per IP
# Default: 10 requests/minute
RATE_LIMIT_PER_MINUTE=10

# Number of document chunks to retrieve per query (top_k)
# Default: 5, Recommended: 3-10
DEFAULT_TOP_K=5

# Chunk size for document splitting (tokens)
# Default: 500, Recommended: 300-1000
CHUNK_SIZE=500

# Chunk overlap for document splitting (tokens)
# Default: 50, Recommended: 30-100
CHUNK_OVERLAP=50

# -----------------------------------------------------------------------------
# Alternative LLM Providers (Optional - if not using OpenAI)
# -----------------------------------------------------------------------------
# Anthropic API key (if using Claude instead of OpenAI)
# Get from: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Cohere API key (if using Cohere embeddings)
# Get from: https://dashboard.cohere.com
# COHERE_API_KEY=your-cohere-api-key-here

# =============================================================================
# QUICK START
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in required variables (OPENAI_API_KEY, QDRANT_*, DATABASE_URL, INGEST_API_KEY)
# 3. Create virtual environment: python -m venv venv
# 4. Activate: venv\Scripts\activate (Windows) or source venv/bin/activate (Mac/Linux)
# 5. Install dependencies: pip install -r requirements.txt
# 6. Start server: make dev (or uvicorn app.main:app --reload --port 8000)
# 7. Visit API docs: http://localhost:8000/docs
#
# =============================================================================
# REQUIRED VARIABLES CHECKLIST
# =============================================================================
# [ ] OPENAI_API_KEY         - OpenAI API key
# [ ] QDRANT_URL             - Qdrant Cloud URL
# [ ] QDRANT_API_KEY         - Qdrant API key
# [ ] DATABASE_URL           - PostgreSQL connection string
# [ ] INGEST_API_KEY         - Ingestion endpoint secret
#
# =============================================================================
# GETTING API KEYS
# =============================================================================
# OpenAI:       https://platform.openai.com/api-keys
# Qdrant:       https://cloud.qdrant.io (create cluster + API key)
# Neon Postgres: https://console.neon.tech (create project + connection string)
# GitHub:       https://github.com/settings/tokens (only for private repos)
#
# =============================================================================
# SECURITY NOTES
# =============================================================================
# ✓ Never commit .env files to version control
# ✓ Use strong random keys for INGEST_API_KEY
# ✓ Rotate API keys periodically
# ✓ Use environment-specific API keys (test vs production)
# ✓ Restrict CORS origins in production
# ✓ Monitor rate limits and API usage
#
# =============================================================================
